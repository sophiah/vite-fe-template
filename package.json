{
  "name": "react-fe-template",
  "version": "1.0.0",
  "private": true,
  "description": "Quick-start React + MUI template with @core alias and folder-based components.",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "start": "npm run dev",
    "preview": "vite preview",
    "lint": "node ./node_modules/eslint/bin/eslint.js \"src/**/*.{js,jsx}\"",
    "lint:fix": "node ./node_modules/eslint/bin/eslint.js \"src/**/*.{js,jsx}\" --fix"
  },
  "dependencies": {
    "@casl/ability": "^6.8.0",
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.0",
    "@mui/icons-material": "^7.0.0",
    "@mui/material": "^7.0.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-router-dom": "^6.30.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.23.0",
    "@vitejs/plugin-react": "^4.4.1",
    "eslint": "^9.23.0",
    "eslint-import-resolver-alias": "^1.1.2",
    "eslint-plugin-import": "^2.31.0",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^5.2.0",
    "globals": "^16.0.0",
    "vite": "^5.4.19"
  },
  "engines": {
    "node": ">=18"
